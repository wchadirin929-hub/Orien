# This file contains defaults for gn values in Chromium which are always
# overridden in Brave builds. This file in particular is only included in
# builds for non-mobile builds (mac, linux, win)

safe_browsing_mode = 1

# Super lightweight / debloated build configuration:
# 1. AI and Assistant features
enable_ai_chat = false
enable_local_ai = false

# 2. Crypto, Web3, and Wallets
enable_brave_wallet = false

# 3. VPN
enable_brave_vpn_v1 = false
enable_brave_vpn_v2 = false

# 4. Ads, Rewards, and News
enable_brave_rewards = false
enable_brave_ads = false
enable_brave_news = false

# 5. Background integrations and auxiliary features
enable_brave_talk = false
enable_tor = false
enable_speedreader = false
enable_web_discovery = false
enable_web_discovery_native = false
enable_brave_wayback_machine = false
enable_playlist = false
enable_brave_education = false
enable_brave_stats_updater = false
enable_psst = false
enable_text_recognition = false

# 6. Service keys (prevent is_official_build assertions)
brave_services_key = "dummy_orien_services_key"
service_key_search = "dummy_orien_search_key"
service_key_stt = "dummy_orien_stt_key"
service_key_aichat = "dummy_orien_aichat_key"

# 7. Siso bypass and build optimizations
use_siso = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
